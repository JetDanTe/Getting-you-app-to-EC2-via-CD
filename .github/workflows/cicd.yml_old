name: CI Pipeline

on:
  push:
    branches: [ master, dev, hw ]
    tags:
      - 'v*.*.*'
  pull_request:
    branches: [ master ]

env:
  AWS_REGION: us-east-1
  ECR_REPOSITORY_NAME: go-to-do-app
  IMAGE_TAG: ${{ github.sha }}

jobs:
  build-and-push:
    name: Build and Push to ECR
    runs-on: ubuntu-latest
    
    steps:
    - name: Check out code
      uses: actions/checkout@v3

    - name: Configure AWS credentials
      uses: aws-actions/configure-aws-credentials@v2
      with:
        aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
        aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
        aws-region: ${{ env.AWS_REGION }}

    - name: Login to Amazon ECR
      id: login-ecr
      uses: aws-actions/amazon-ecr-login@v2

    - name: Set up dynamic image tag
      id: set-tag
      run: |
        if [[ $GITHUB_REF == refs/tags/* ]]; then
          VERSION=${GITHUB_REF#refs/tags/}
          echo "TAG=$VERSION" >> $GITHUB_ENV
        elif [[ $GITHUB_REF == refs/heads/master ]]; then
          echo "TAG=master" >> $GITHUB_ENV
        elif [[ $GITHUB_REF == refs/heads/dev ]]; then
          echo "TAG=dev" >> $GITHUB_ENV
        else
          echo "TAG=${{ github.sha }}" >> $GITHUB_ENV
        fi
        
        echo "ECR_URL=${{ steps.login-ecr.outputs.registry }}/${{ env.ECR_REPOSITORY_NAME }}" > .env
        echo "IMAGE_TAG=$TAG" >> .env

      
    - name: Build, tag, and push image to Amazon ECR
      env:
        ECR_REGISTRY: ${{ steps.login-ecr.outputs.registry }}
        ECR_REPOSITORY: go-to-do-app
        IMAGE_TAG: ${{ env.IMAGE_TAG }}
      run: |
        cd ./src/client
        docker build -t ${ECR_REGISTRY}/${{ env.ECR_REPOSITORY }}-front:${{ env.IMAGE_TAG }} -f Dockerfile .
        docker push ${ECR_REGISTRY}/${{ env.ECR_REPOSITORY }}-front:${{ env.IMAGE_TAG }}
        
        cd ../go-server
        docker build -t ${ECR_REGISTRY}/${{ env.ECR_REPOSITORY }}-back:${{ env.IMAGE_TAG }} -f Dockerfile .
        docker push ${ECR_REGISTRY}/${{ env.ECR_REPOSITORY }}-back:${{ env.IMAGE_TAG }}
        
        docker images

      continue-on-error: false

    - name: Print image URI
      run: |
        echo "Image URI: ${{ steps.login-ecr.outputs.registry }}/${{ env.ECR_REPOSITORY_NAME }}:${{ env.IMAGE_TAG }}"
    
    - name: Copy files to EC2
      uses: appleboy/scp-action@master
      with:
        host: ${{ secrets.EC2_PUBLIC_IP }}
        username: ${{ secrets.EC2_USERNAME }}
        key: ${{ secrets.EC2_SSH_PRIVATE_KEY }}
        source: "docker-compose.yml,.env"
        target: "/home/${{ secrets.EC2_USERNAME }}/app"